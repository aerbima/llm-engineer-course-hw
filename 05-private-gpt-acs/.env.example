# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# .env в Git не попадает (см. .gitignore).

# ollama — локальная модель; openai_compat — эмулятор школы, LM Studio, vLLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3
NUM_CTX=8192
LLM_TEMPERATURE=0.1

# Только для LLM_PROVIDER=openai_compat
OPENAI_BASE_URL=
OPENAI_API_KEY=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
SCORE_THRESHOLD=0.45

MEMORY_MODE=summary_buffer
MEMORY_K=3
MAX_HISTORY_TOKENS=600
CONDENSE_QUESTION=1

# Телеметрия библиотек выключена (закрытый контур)
GRADIO_ANALYTICS_ENABLED=False
ANONYMIZED_TELEMETRY=False
